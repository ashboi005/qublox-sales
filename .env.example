# Your existing PostgreSQL, reachable from the app containers. URL-encode credentials.
DATABASE_URL=postgresql://qublox:replace-password@your-postgres-host:5432/qublox_sales
# Only needed when opting into compose.postgres.yml; not used for an existing DB.
# POSTGRES_PASSWORD=replace-with-random-hex
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=https://sales.your-domain.com
ALLOWED_EMAILS=you@your-domain.com,sayam@your-domain.com
MERGE_GATEWAY_API_KEY=
MERGE_MODEL=
LLM_MONTHLY_BUDGET_USD=5
DAILY_CONTACT_LIMIT=5
WEB_PORT=3001
