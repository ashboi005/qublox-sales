# Copy to .env for Docker deployment. Replace every placeholder.
POSTGRES_PASSWORD=replace-with-a-long-random-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=https://sales.your-domain.com
ALLOWED_EMAILS=you@your-domain.com,sayam@your-domain.com
MERGE_GATEWAY_API_KEY=
# Exact model identifier from your Merge Gateway catalog. Leave empty for manual drafting.
MERGE_MODEL=
LLM_MONTHLY_BUDGET_USD=5
DAILY_CONTACT_LIMIT=5
