DATABASE_URL=postgresql://qublox:replace-password@your-postgres-host:5432/qublox_sales
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=https://sales.qubloxhq.com
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=
LLM_RPM=1
LLM_RPD=20
LLM_TPM=8000
LLM_TPD=100000
LLM_MONTHLY_BUDGET_USD=1
AUTO_PIPELINE=true
DAILY_CONTACT_LIMIT=10
