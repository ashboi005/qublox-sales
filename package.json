{
  "name": "qublox-sales",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.3",
      "varlock": "1.23.0",
      "better-auth": "1.7.12",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.5"
    }
  },
  "type": "module",
  "scripts": {
    "format": "prettier --write 'apps/*/src/**/*.{ts,tsx,css}' 'apps/server/integration/*.ts' 'packages/*/src/**/*.ts' 'scripts/*.ts' '*.json' '*.yml' 'apps/*/package.json' 'packages/*/package.json'",
    "dev": "bun run --parallel dev:web dev:server dev:worker",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:web": "bun run --filter web dev",
    "dev:server": "bun run --filter server dev",
    "dev:worker": "bun run --filter server dev:worker",
    "team:add": "cd apps/server && bun run team:add",
    "db:push": "bun run --filter @qublox-sales/db db:push",
    "db:studio": "bun run --filter @qublox-sales/db db:studio",
    "db:generate": "bun run --filter @qublox-sales/db db:generate",
    "db:migrate": "bun run --filter @qublox-sales/db db:migrate",
    "db:backup": "bun scripts/backup.ts",
    "db:start": "docker compose -f compose.dev.yml up -d --wait postgres",
    "db:watch": "docker compose -f compose.dev.yml up postgres",
    "db:stop": "docker compose -f compose.dev.yml stop postgres",
    "db:down": "docker compose -f compose.dev.yml down",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && bun run auth:generate",
    "setup": "bun scripts/setup.ts",
    "test": "bun test apps/server/src packages/shared/src packages/auth/src apps/maps-extension/tests",
    "extension:build": "bun scripts/build-extension.ts",
    "test:integration": "bun scripts/test-integration.ts",
    "simulate": "bun scripts/simulate-workflow.ts",
    "models:check": "bun scripts/check-models.ts",
    "research:sample": "bun scripts/research-sample.ts docs/research/scraper-sample-sites.json",
    "team:remove": "cd apps/server && bun run team:remove",
    "team:role": "cd apps/server && bun run team:role",
    "team:migrate": "cd apps/server && bun run team:migrate"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@qublox-sales/config": "workspace:*",
    "@types/bun": "catalog:",
    "fflate": "0.8.3",
    "linkedom": "0.18.12",
    "prettier": "3.6.2",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "packageManager": "bun@1.3.10"
}
