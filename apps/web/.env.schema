# The web app holds no secrets and needs no .env file. These defaults are for local
# development; Docker/Coolify sets the real values (see docker-compose.yml).
# @defaultRequired=true
# @defaultSensitive=false
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @type=enum(development, production, test)
NODE_ENV=development

# Public address of the site. Informational only: the browser uses relative /api paths,
# so an empty or missing value must never stop the container from starting.
# @required=false
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# API upstream for the /api proxy (the dev API runs on PORT 3100).
# @required=false
SERVER_URL=http://localhost:3100
