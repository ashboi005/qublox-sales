# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=port
PORT=3100

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# @public @required=false @type=enum(groq, gemini)
LLM_PROVIDER=groq

# @required=false
GROQ_API_KEY=

# @required=false
GEMINI_API_KEY=

# @public @required=false
LLM_MODEL=

# Alternate between Groq and Gemini when both keys are set.
# @public @required=false @type=enum(true, false)
LLM_ROTATE=true

# @public @required=false @type=number
GROQ_RPM=20

# @public @required=false @type=number
GROQ_RPD=800

# @public @required=false @type=number
GROQ_TPM=8000

# @public @required=false @type=number
GROQ_TPD=180000

# @public @required=false @type=number
GEMINI_RPM=10

# @public @required=false @type=number
GEMINI_RPD=250

# @public @required=false @type=number
GEMINI_TPM=200000

# @public @required=false @type=number
GEMINI_TPD=2000000

# @public @required=false @type=number
LLM_MONTHLY_BUDGET_USD=1

# Google Places API (New) key for "Find leads". Empty falls back to OpenStreetMap.
# @sensitive @required=false
GOOGLE_PLACES_API_KEY=

# Searches per month (20 businesses each); stays under Google's 1,000 free.
# @public @required=false @type=number
PLACES_MONTHLY_REQUEST_LIMIT=900

# Research new leads with an offer, then draft them, automatically. Approval stays manual.
# @public @required=false @type=boolean
AUTO_PIPELINE=true

# @public @required=false @type=number
DAILY_CONTACT_LIMIT=10

# @public @required=false @type=boolean
EMAIL_SENDING_ENABLED=false

# Company name used in drafts ("Asha here from Qublox") and the From line.
# @public @required=false
COMPANY_NAME=Qublox

# @public @required=false @type=number
EMAIL_MIN_INTERVAL_SECONDS=120

# @public @required=false @type=number
EMAIL_ACCOUNT_INTERVAL_SECONDS=600

# Website audit: Google PageSpeed Insights key (free, no billing). Empty skips the speed test.
# @required=false
PAGESPEED_API_KEY=

# Read hard sites through Jina Reader, then Firecrawl, when our own fetch fails.
# @public @required=false @type=enum(true, false)
PAGE_READER_FALLBACK=true

# Optional; Jina works free without a key.
# @required=false
JINA_API_KEY=

# Firecrawl free plan key (1,000 pages a month, no card).
# @required=false
FIRECRAWL_API_KEY=

# @public @required=false @type=number
FIRECRAWL_MONTHLY_LIMIT=900

# On-demand email verification (Reoon).
# @required=false
REOON_API_KEY=

# @public @required=false @type=number
REOON_MONTHLY_LIMIT=500
