{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "dev:worker": "bun run --watch src/worker.ts",
    "worker": "bun run dist/worker.mjs",
    "team:add": "bun src/provision.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@qublox-sales/auth": "workspace:*",
    "@qublox-sales/db": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "catalog:",
    "cheerio": "^1.2.0",
    "elysia": "^1.4.30",
    "ipaddr.js": "^2.5.0",
    "varlock": "catalog:",
    "zod": "catalog:",
    "@qublox-sales/shared": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@qublox-sales/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
